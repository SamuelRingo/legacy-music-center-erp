generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & PROFILES ====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  schedules      Schedule[]      @relation("TeacherSchedules")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  STAFF
  TEACHER
  STUDENT
}

enum Status {
  PENDING
  ACTIVE
  INACTIVE
}

model StudentProfile {
  id          String @id @default(uuid())
  userId      String @unique
  parentPhone String?
  address     String?

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  invoices    Invoice[]

  @@map("student_profiles")
}

model TeacherProfile {
  id             String @id @default(uuid())
  userId         String @unique
  specialization String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

// ==================== ACADEMIC ====================

model Course {
  id          String @id @default(uuid())
  name        String
  description String?
  price       Float  @default(300000)
  createdAt   DateTime @default(now())

  schedules Schedule[]

  @@map("courses")
}

model Classroom {
  id        String @id @default(uuid())
  name      String
  capacity  Int    @default(20)
  createdAt DateTime @default(now())

  schedules Schedule[]

  @@map("classrooms")
}

model Schedule {
  id          String   @id @default(uuid())
  courseId    String
  teacherId   String
  classroomId String
  day         Day
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  createdAt   DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id])
  teacher     User         @relation("TeacherSchedules", fields: [teacherId], references: [id])
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  enrollments Enrollment[]
  meetings    Meeting[]

  @@map("schedules")
}

enum Day {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  scheduleId String
  enrolledAt DateTime @default(now())

  student            StudentProfile      @relation(fields: [studentId], references: [id])
  schedule           Schedule            @relation(fields: [scheduleId], references: [id])
  meetingAttendances MeetingAttendance[]
  finalGrades        FinalGrade[]

  @@unique([studentId, scheduleId])
  @@map("enrollments")
}

// ==================== ATTENDANCE & GRADING ====================

model Meeting {
  id          String   @id @default(uuid())
  scheduleId  String
  title       String   // "Pertemuan ke-1", auto-increment per schedule
  meetingDate DateTime
  journal     String?  // 1 jurnal per pertemuan
  createdAt   DateTime @default(now())

  schedule    Schedule            @relation(fields: [scheduleId], references: [id])
  attendances MeetingAttendance[]

  @@map("meetings")
}

model MeetingAttendance {
  id           String           @id @default(uuid())
  meetingId    String
  enrollmentId String
  status       AttendanceStatus // HADIR/ABSEN/IZIN/SAKIT
  note         String?

  meeting    Meeting    @relation(fields: [meetingId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([meetingId, enrollmentId])
  @@map("meeting_attendances")
}

enum AttendanceStatus {
  HADIR
  ABSEN
  IZIN
  SAKIT
}

model FinalGrade {
  id           String @id @default(uuid())
  enrollmentId String @unique
  score        Int    // 0-100
  evaluation   String? // Catatan evaluasi semester

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("final_grades")
}

// ==================== FINANCE ====================

model Invoice {
  id        String        @id @default(uuid())
  studentId String
  month     Int           // 1-12
  year      Int
  amount    Float         @default(0)
  status    InvoiceStatus @default(UNPAID)
  bankRef   String?       // Nomor Referensi Bank
  proofUrl  String?       // URL bukti transfer di Supabase Storage
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([studentId, month, year])
  @@map("invoices")
}

enum InvoiceStatus {
  UNPAID
  PAID
}

// ==================== CMS ====================

model EventBanner {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String   // URL di Supabase Storage
  createdAt   DateTime @default(now())

  @@map("event_banners")
}

// ==================== CMS LANDING PAGE ====================

model LandingContent {
  id        String   @id @default(uuid())
  section   String   // "hero", "about", "facility", "footer", "chatbot"
  key       String   // "slider_1", "about_text", "facility_piano_img", dll
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@map("landing_content")
}
